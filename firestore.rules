rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // JB STAR administrator account UID.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'GK24JSFswVerd7cqvhdfmHPb93K3';
    }

    function isUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly(['uid', 'phoneNumber', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'phoneNumber', 'updatedAt'])
        && request.resource.data.uid == userId
        && (request.resource.data.phoneNumber == null || request.resource.data.phoneNumber is string)
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow create: if isUser(userId) && validUserProfile(userId);
      allow read: if isUser(userId) || isAdmin();
      allow update: if isAdmin() || (isUser(userId)
        && validUserProfile(userId)
        && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    match /content/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /matches/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
